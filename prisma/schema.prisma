generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  name      String?
  avatar    String?
  googleId  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
}

model Product {
  id            String   @id @default(uuid())
  name          String
  description   String
  price         Float
  brand         String?
  category      String
  isNew         Boolean  @default(false)
  isBestSeller  Boolean  @default(false)
  isSoldOut     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  images              Image[]
  variants            Variant[]
  stockNotifications  StockNotification[]
  bundleItems         BundleProduct[]
  reviews             Review[]
}

model Image {
  id        String  @id @default(uuid())
  url       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Variant {
  id        String  @id @default(uuid())
  color     String
  size      String
  stock     Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
}

model StockNotification {
  id        String   @id @default(uuid())
  email     String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Bundle {
  id          String          @id @default(uuid())
  name        String
  description String?
  discount    Float           @default(15)
  products    BundleProduct[]
  createdAt   DateTime        @default(now())
}

model BundleProduct {
  id        String  @id @default(uuid())
  bundleId  String
  productId String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model LoyaltyAccount {
  id        String             @id @default(uuid())
  email     String             @unique
  points    Int                @default(0)
  tier      String             @default("CHROME")
  history   PointTransaction[]
  createdAt DateTime           @default(now())
}

model PointTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  points           Int
  reason           String
  createdAt        DateTime       @default(now())
}

model Address {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  fullName  String
  phone     String
  street    String
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  createdAt DateTime @default(now())

  orders    Order[]
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  customerEmail     String
  customerPhone     String
  totalAmount       Float
  shippingAmount    Float       @default(0)
  discountAmount    Float       @default(0)
  paymentStatus     String      @default("PENDING") // PENDING, PAID, FAILED
  orderStatus       String      @default("PROCESSING") // AWAITING_PAYMENT, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  paymentMethod     String      // RAZORPAY, COD
  razorpayOrderId   String?     @unique
  paymentId         String?
  signature         String?
  trackingId        String?
  shippingAddressId String
  shippingAddress   Address     @relation(fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     Float
  size      String
  color     String
  quantity  Int
  image     String
}

model MarketingCampaign {
  id          String   @id @default(uuid())
  title       String
  subject     String
  previewText String?
  bannerImage String?
  headline    String?
  promoBadge  String?
  productIds  String   @default("[]") // JSON stringified array of product IDs
  sentCount   Int      @default(0)
  createdAt   DateTime @default(now())
}

model SupportTicket {
  id          String   @id @default(uuid())
  name        String
  email       String
  orderNumber String?
  message     String
  status      String   @default("OPEN") // OPEN, CLOSED
  createdAt   DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  authorName String
  rating     Int      // 1-5
  body       String
  createdAt  DateTime @default(now())

  @@unique([productId, userId])
}
